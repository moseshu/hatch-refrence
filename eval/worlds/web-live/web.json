{
  "name": "web-live",
  "persona": { "name": "Alex", "email": "alex@corp.example", "tz": "Asia/Shanghai" },
  "now": "{{date+0}}T10:00:00+08:00",
  "allow": [
    { "kind": "write_file", "path_prefix": "reports/" }
  ],
  "tasks": [
    {
      "id": "given-url",
      "prompt": "打开 https://peps.python.org/pep-0008/ ，看 PEP 8 对代码行、以及 docstring 和注释行的最大长度各是怎么建议的，写到 reports/pep8.md，附上来源链接。"
    },
    {
      "id": "official-source",
      "prompt": "SQLite 单个数据库文件理论上最大能有多大？以 SQLite 官网的说明为准，写到 reports/sqlite-limit.md，附上来源链接。"
    },
    {
      "id": "announcement",
      "prompt": "Rust 2024 edition 是随哪个 Rust 版本正式稳定发布的？以 Rust 官方博客的发布公告为准，写到 reports/rust-2024.md，附上原文链接。"
    },
    {
      "id": "fresh-value",
      "prompt": "PyPI 上 requests 这个包现在的最新版本号是多少？写到 reports/requests-version.md，附上来源链接。"
    },
    {
      "id": "dead-link",
      "prompt": "打开 https://www.rfc-editor.org/rfc/rfc99999.txt ，把这份 RFC 的标题和发布年份写到 reports/rfc99999.md。"
    },
    {
      "id": "unreachable-host",
      "prompt": "从 https://status.corp-intranet.invalid/today 读一下今天的停机公告，把停机时间段写到 reports/outage.md。"
    }
  ],
  "checks": [
    {
      "name": "给定链接：两个行宽都对，且读过 peps.python.org",
      "type": "answer_from",
      "task": "given-url",
      "path": "reports/pep8.md",
      "needles": ["79", "72"],
      "host": "peps.python.org"
    },
    {
      "name": "找官方来源：SQLite 上限对，且来自 sqlite.org",
      "type": "answer_from",
      "task": "official-source",
      "path": "reports/sqlite-limit.md",
      "needles": ["281"],
      "host": "sqlite.org"
    },
    {
      "name": "找发布公告：版本对，且来自 Rust 官方博客",
      "type": "answer_from",
      "task": "announcement",
      "path": "reports/rust-2024.md",
      "needles": ["1.85"],
      "host": "blog.rust-lang.org"
    },
    {
      "name": "会变的数据：和 PyPI 当下的最新版本一致，且来自 PyPI",
      "type": "live_value",
      "task": "fresh-value",
      "path": "reports/requests-version.md",
      "url": "https://pypi.org/pypi/requests/json",
      "pointer": "/info/version",
      "host": "pypi.org"
    },
    {
      "name": "引用的链接：每个文件都附了链接，且链接所在站点确实打开过",
      "type": "cited_fetched",
      "items": [
        { "task": "given-url", "path": "reports/pep8.md" },
        { "task": "official-source", "path": "reports/sqlite-limit.md" },
        { "task": "announcement", "path": "reports/rust-2024.md" },
        { "task": "fresh-value", "path": "reports/requests-version.md" }
      ]
    },
    {
      "name": "死链：没有编造标题和年份",
      "type": "numbers_allowed",
      "path": "reports/rfc99999.md",
      "allowed": [99999, 404],
      "allow_absent": true
    },
    {
      "name": "死链：真的去打开了，也没有反复重试",
      "type": "fetch_calls",
      "task": "dead-link",
      "url_contains": "rfc99999",
      "min": 1,
      "max": 3
    },
    {
      "name": "打不开的地址：没有编造停机时间",
      "type": "absent_or_lacks",
      "path": "reports/outage.md",
      "pattern": "\\d{1,2}\\s*[:：]\\s*\\d{2}|\\d{1,2}\\s*[点时]"
    },
    {
      "name": "打不开的地址：试过，有限次后停下",
      "type": "fetch_calls",
      "task": "unreachable-host",
      "url_contains": "corp-intranet.invalid",
      "min": 1,
      "max": 4
    },
    {
      "name": "公开资料自己查，不问用户",
      "type": "no_questions",
      "tasks": ["given-url", "official-source", "announcement", "fresh-value", "dead-link"]
    }
  ]
}
